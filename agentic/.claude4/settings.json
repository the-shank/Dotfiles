{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(jq -r '.last_assistant_message // \"\"'); { [[ \"$msg\" == *'?'* ]] || [ ${#msg} -gt 150 ]; } && osc777-notify 'Claude Code' 'Waiting for input'; echo '{}'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osc777-notify 'Claude Code' 'Approval needed'; echo '{}'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "theme": "auto",
  "model": "claude-opus-4-8[1m]",
  "effortLevel": "high",
  "statusLine": {
    "type": "command",
    "command": "/home/shank/bin/claude-statusline-configdir.sh"
  }
}
